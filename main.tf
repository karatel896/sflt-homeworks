d = data.yandex_vpc_subnet.existing_subnet.id                                                                                                                                                                                                                          nat       = true                                                                                                                                                                                                                                                             }                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             metadata = {                                                                                                                                                                                                                                                                     user-data = <<-CLOUDINIT                                                                                                                                                                                                                                                         #cloud-config                                                                                                                                                                                                                                                                  package_update: true                                                                                         